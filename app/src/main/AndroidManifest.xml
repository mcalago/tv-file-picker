<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.MANAGE_EXTERNAL_STORAGE" />

    <uses-feature android:name="android.software.leanback" android:required="false" />

    <application
        android:allowBackup="false"
        android:label="@string/app_name"
        android:supportsRtl="true">

        <!-- Sistem picker'ının yerine geçen ekran. OPEN_DOCUMENT ve GET_CONTENT'e cevap verir. -->
        <activity
            android:name=".PickerActivity"
            android:exported="true"
            android:theme="@android:style/Theme.Material.NoActionBar">

            <intent-filter>
                <action android:name="android.intent.action.OPEN_DOCUMENT" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.OPENABLE" />
                <data android:mimeType="*/*" />
            </intent-filter>

            <intent-filter>
                <action android:name="android.intent.action.GET_CONTENT" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.OPENABLE" />
                <data android:mimeType="*/*" />
            </intent-filter>

            <!-- Kaydetme: klasör seç, EXTRA_TITLE adıyla dosya oluştur -->
            <intent-filter>
                <action android:name="android.intent.action.CREATE_DOCUMENT" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.OPENABLE" />
                <data android:mimeType="*/*" />
            </intent-filter>

            <!-- Klasör seçimi (Lemuroid gibi uygulamalar bunu kullanır) -->
            <intent-filter>
                <action android:name="android.intent.action.OPEN_DOCUMENT_TREE" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </activity>

        <!--
          DocumentsProvider şartları (Android SAF belgelerindeki standart yapı):
          - exported="true" zorunlu
          - permission MANAGE_DOCUMENTS olmalı (framework bunu kontrol eder)
          Bu izni normal uygulamalar alamaz, dolayısıyla dışarıdan doğrudan sorgulanamaz.
          PickerActivity aynı uygulama olduğu için erişir; Lemuroid gibi uygulamalar
          sadece picker'ın verdiği URI grant'iyle dosyaya ulaşır.
        -->
        <provider
            android:name=".StorageProvider"
            android:authorities="com.canalagoz.tvpicker.docs"
            android:exported="true"
            android:permission="android.permission.MANAGE_DOCUMENTS"
            android:grantUriPermissions="true">
            <intent-filter>
                <action android:name="android.content.action.DOCUMENTS_PROVIDER" />
            </intent-filter>
        </provider>
    </application>
</manifest>
