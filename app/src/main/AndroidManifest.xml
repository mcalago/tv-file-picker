<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.MANAGE_EXTERNAL_STORAGE" />
    <!-- Android 9 and 10 have no "all files" screen; the regular storage permissions are used instead -->
    <uses-permission android:name="android.permission.READ_EXTERNAL_STORAGE" android:maxSdkVersion="29" />
    <uses-permission android:name="android.permission.WRITE_EXTERNAL_STORAGE" android:maxSdkVersion="29" />

    <uses-feature android:name="android.software.leanback" android:required="false" />
    <!-- TVs have no touchscreen; without this line Google Play hides the app from TV devices -->
    <uses-feature android:name="android.hardware.touchscreen" android:required="false" />

    <application
        android:allowBackup="false"
        android:banner="@drawable/banner"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:requestLegacyExternalStorage="true"
        android:supportsRtl="true">

        <!-- What people see when they open the app: a two-step setup guide -->
        <activity
            android:name=".SetupActivity"
            android:exported="true"
            android:theme="@android:style/Theme.Material.NoActionBar">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
                <category android:name="android.intent.category.LEANBACK_LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Replaces the system picker. Answers OPEN_DOCUMENT and GET_CONTENT. -->
        <activity
            android:name=".PickerActivity"
            android:exported="true"
            android:theme="@android:style/Theme.Material.NoActionBar">

            <intent-filter>
                <action android:name="android.intent.action.OPEN_DOCUMENT" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.OPENABLE" />
                <data android:mimeType="*/*" />
            </intent-filter>

            <intent-filter>
                <action android:name="android.intent.action.GET_CONTENT" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.OPENABLE" />
                <data android:mimeType="*/*" />
            </intent-filter>

            <!-- Save: pick a folder, create a file named EXTRA_TITLE -->
            <intent-filter>
                <action android:name="android.intent.action.CREATE_DOCUMENT" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.OPENABLE" />
                <data android:mimeType="*/*" />
            </intent-filter>

            <!-- Folder selection (used by apps such as Lemuroid) -->
            <intent-filter>
                <action android:name="android.intent.action.OPEN_DOCUMENT_TREE" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </activity>

        <activity
            android:name=".AboutActivity"
            android:exported="false"
            android:theme="@android:style/Theme.Material.NoActionBar" />

        <!--
          DocumentsProvider requirements (the standard setup from the Android SAF docs):
          - exported="true" is required
          - permission must be MANAGE_DOCUMENTS (the framework checks it)
          Regular apps cannot hold this permission, so the provider cannot be queried directly from outside.
          PickerActivity can reach it because it is part of the same app; apps such as Lemuroid
          only reach files through the URI grant the picker hands out.
        -->
        <provider
            android:name=".StorageProvider"
            android:authorities="com.mcanalagoz.tvpicker.docs"
            android:exported="true"
            android:permission="android.permission.MANAGE_DOCUMENTS"
            android:grantUriPermissions="true">
            <intent-filter>
                <action android:name="android.content.action.DOCUMENTS_PROVIDER" />
            </intent-filter>
        </provider>
    </application>
</manifest>
